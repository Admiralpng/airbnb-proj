{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "create-react-app"
    },
    "airbnb-api": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "airbnb-api"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "airbnb-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
